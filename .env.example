DB_PASSWORD=
JWT_SECRET=
# Ejecución local: reemplazar el usuario, contraseña y nombre según corresponda.
DATABASE_URL=postgresql://admin:CHANGE_ME@localhost:5432/mi_proyecto

# Base separada de PostgreSQL para pruebas de integración (opcional).
# Ejemplo: postgresql://admin:<password>@127.0.0.1:5432/mi_proyecto_test
TEST_DATABASE_URL=

# Pool PostgreSQL por proceso; reiniciar el backend tras modificarlos.
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT_SECONDS=5
